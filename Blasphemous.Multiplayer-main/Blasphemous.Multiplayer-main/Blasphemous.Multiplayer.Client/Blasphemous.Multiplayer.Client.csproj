<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>

    <Title>Multiplayer</Title>
    <Product>Multiplayer</Product>
    <Authors>Damocles</Authors>
    <Company>Damocles</Company>
    <Description>A multiplayer mod that allows you to play Blasphemous cooperatively or against other people</Description>
    <!-- Version handled in Directory.Build.props -->

    <TargetName>BlasClient</TargetName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetName).xml</DocumentationFile>
    <RepositoryUrl>https://github.com/BrandenEK/Blasphemous.Multiplayer</RepositoryUrl>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Interruttore del deploy nella cartella di gioco. FALSE per default: la build non tocca il gioco.
         Per una copia voluta:  dotnet build .\Blasphemous.Multiplayer.sln -p:DeployToGame=true -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blasphemous.CheatConsole" Version="1.1.0" />
    <PackageReference Include="Blasphemous.GameLibs" Version="4.0.67" />
    <PackageReference Include="Blasphemous.ModdingAPI" Version="3.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blasphemous.Multiplayer.Common\Blasphemous.Multiplayer.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SimpleTCP">
      <HintPath>..\resources\data\SimpleTCP.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="Development" AfterTargets="PostBuildEvent">

    <!-- Update dependencies -->
    <Copy SourceFiles="$(OutDir)Blasphemous.Multiplayer.Common.dll" DestinationFolder="$(SolutionDir)\resources\data" SkipUnchangedFiles="true" />

    <!-- Get plugin & resources -->
    <ItemGroup>
      <PluginDll Include="$(TargetPath)" />
      <Resources Include="$(SolutionDir)\resources\**\*.*" />
    </ItemGroup>

    <!-- Get export directories -->
    <PropertyGroup>
      <!-- La cartella di gioco. Il percorso è ASSOLUTO e resta, ma NON è più un bersaglio della build:
           lo era, e ogni `dotnet build` — in qualunque worktree — ci copiava la sua DLL, annullando
           in silenzio il deploy di HEAD (per giorni si è creduto di testare una versione mentre il
           gioco ne eseguiva un'altra). Ora le due Copy verso questa cartella sono spente per default
           (vedi <DeployToGame> in cima al file): l'unico modo di mettere qualcosa in gioco è
           tools\deploy-local.ps1 — così una build di prova non può più sovrascrivere il deploy. -->
      <DevFolder>D:\SteamLibrary\steamapps\common\Blasphemous\Modding\</DevFolder>
      <PublishFolder>$(SolutionDir)\publish\$(TargetName)</PublishFolder>
    </PropertyGroup>

    <!-- Export to dev folder — SOLO se richiesto con -p:DeployToGame=true.
         Senza SkipUnchangedFiles di proposito: una copia voluta deve aggiornare anche il timestamp,
         altrimenti un deploy identico sembra non essere avvenuto. -->
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(DevFolder)\%(RecursiveDir)" Condition="'$(DeployToGame)' == 'true'" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(DevFolder)\plugins" Condition="'$(DeployToGame)' == 'true'" />

    <!-- Export to publish folder -->
    <RemoveDir Directories="$(PublishFolder)" />
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(PublishFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(PublishFolder)\plugins" SkipUnchangedFiles="true" />
    <ZipDirectory SourceDirectory="$(PublishFolder)" DestinationFile="$(PublishFolder)\..\$(TargetName).zip" Overwrite="true" />

  </Target>

  <Target Name="AddGeneratedFile" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)GeneratedFile.cs">

    <!-- Create ModInfo class from relevant data -->
    <PropertyGroup>
      <GeneratedText>
        <![CDATA[ namespace $(RootNamespace) { internal static class ModInfo { public const string MOD_ID = "$(AssemblyName)"%3B public const string MOD_NAME = "$(Product)"%3B public const string MOD_AUTHOR = "$(Company)"%3B public const string MOD_VERSION = "$(Version)"%3B } } ]]>
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)ModInfo.cs</GeneratedFilePath>
    </PropertyGroup>

    <!-- Write ModInfo data to intermediate output -->
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />

  </Target>
  
</Project>

